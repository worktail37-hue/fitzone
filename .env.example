# ==============================================================================
# SERVER-SIDE ONLY SECRETS (NEVER prefix with VITE_, NEXT_PUBLIC_, or REACT_APP_)
# ==============================================================================

# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ==============================================================================
# PUBLIC CLIENT-SAFE VARIABLES (Exposed to the browser via Vite's VITE_ prefix)
# WARNING: Only place public-safe configuration here. Never place private API
# keys, database URLs, Stripe secret keys, OAuth client secrets, JWT secrets,
# or Supabase service_role keys in VITE_* variables.
# ==============================================================================

# VITE_SITE_NAME: Public display name for the application.
VITE_SITE_NAME="FITZONE"

# VITE_APP_URL: Public base URL of the site (optional).
VITE_APP_URL=""

# VITE_SUPPORT_EMAIL: Public concierge/support contact email displayed in UI.
VITE_SUPPORT_EMAIL="concierge@fitzone.club"

# VITE_FORM_ENDPOINT: Optional HTTPS backend endpoint for the Free Trial form submission.
# Leave empty during local preview to use the built-in 1-second simulated demo handler.
VITE_FORM_ENDPOINT=""
